{
  "$schema": "https://biomejs.dev/schemas/2.2.4/schema.json",
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "overrides": [
    {
      "includes": ["src/styles.css"],
      "linter": {
        "rules": {
          "suspicious": {
            "noUnknownAtRules": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/components/**",
        "src/popup/popup-view.tsx",
        "src/popup/popup-layout.tsx",
        "src/popup/moment-form.tsx",
        "src/popup/moment-list.tsx",
        "src/popup/video-card.tsx",
        "src/youtube/action.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "wxt/browser": "Read browser state in a hook or WXT lifecycle module and pass it as props.",
                  "react-dom/client": "Mount React roots in an entrypoint or WXT lifecycle module."
                }
              }
            }
          }
        }
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
