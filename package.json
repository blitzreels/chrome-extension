{
  "name": "@blitzreels/chrome-extension",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "Save YouTube timestamps and notes in the BlitzReels Chrome popup.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.3.4",
  "homepage": "https://blitzreels.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blitzreels/chrome-extension.git"
  },
  "bugs": {
    "url": "https://github.com/blitzreels/chrome-extension/issues"
  },
  "scripts": {
    "dev": "wxt",
    "postinstall": "wxt prepare",
    "build": "wxt build && node scripts/stage.mjs",
    "typecheck": "wxt prepare && tsc --noEmit",
    "lint": "biome check src entrypoints scripts tests preview *.ts *.json",
    "lint:fix": "pnpm lint --write",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "node tests/extension.e2e.mjs",
    "preview": "vite --config vite.preview.config.ts",
    "package": "pnpm verify && wxt zip && node scripts/check-store-release.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm test:e2e"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.2.4",
    "@fontsource-variable/onest": "5.2.6",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.18.6",
    "@types/react": "19.1.14",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "6.0.4",
    "@wxt-dev/module-react": "1.2.2",
    "playwright": "1.55.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "8.2.2",
    "wxt": "0.21.4"
  }
}
